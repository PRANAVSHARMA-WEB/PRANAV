SELECT 
	e.emp_name,e.salary
    from employees e
    left join dep d on e.dept_id= d.dept_id
    where e.dept_id is null;
    select
    d.dept_name,
    max(e.salary) as maxsalary
    from dep d
    inner join 
    employees AS e
    on d.dept_id=e.dept_id group by d.dept_name;
    
