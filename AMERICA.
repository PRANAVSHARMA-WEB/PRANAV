SELECT location, sum(budget) as total FROM dep GROUP BY location;
SELECT location, count(*) as count FROM dep GROUP BY location HAVING count(*)>2;
SELECT location, min(budget) as mindata FROM dep GROUP BY location;
SELECT 
location,
min(budget) as minvalue
FROM 	dep
GROUP BY location 
HAVING minvalue>150000;
